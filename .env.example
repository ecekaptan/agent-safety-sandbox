# Copy this file to .env and fill it in. .env is git-ignored: never commit it.
# Inspect loads .env automatically from the directory you run it in.

# Model to evaluate, as provider/model-name (see https://inspect.aisi.org.uk/providers.html).
# Example: INSPECT_EVAL_MODEL=anthropic/claude-sonnet-4-6
INSPECT_EVAL_MODEL=

# API key for the provider named above.
ANTHROPIC_API_KEY=
