# Inspect loads .env automatically from the directory you run it in.

# Model to evaluate, as provider/model-name (see https://inspect.aisi.org.uk/providers.html).
# Examples:
#   google/gemini-2.5-flash
#   openrouter/meta-llama/llama-3.3-70b-instruct
#   openrouter/qwen/qwen-2.5-72b-instruct
INSPECT_EVAL_MODEL=

# API key for whichever provider you use. Set the one(s) you need.
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
